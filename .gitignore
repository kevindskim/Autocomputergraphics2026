# =========================================================
# CASADPreprojectEx3 - .gitignore
# C++ / CMake / Windows (VS + VS Code)
# =========================================================

# Build directories
/build/
/build*/
/cmake-build*/
/out/
/bin/
/lib/

# CMake generated files
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
install_manifest.txt
compile_commands.json
CTestTestfile.cmake
Testing/
Makefile

# CPack / CTest artifacts
CPackConfig.cmake
CPackSourceConfig.cmake
_Dash*/*

# Visual Studio
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
*.VC.db
*.VC.opendb
*.opendb
ipch/

# MSBuild / VC++ intermediate outputs
*.obj
*.iobj
*.ipdb
*.pdb
*.ilk
*.idb
*.pch
*.aps
*.tlog
*.lastbuildstate
*.tmp
*.log
*.cache
*.db
*.exe
*.dll
*.lib
*.exp
*.manifest

# Ninja / NMake artifacts
.ninja_deps
.ninja_log

# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# CLion / JetBrains
.idea/

# User/local CMake presets
CMakeUserPresets.json

# Python cache/artifacts (for helper scripts)
__pycache__/
*.py[cod]
*.pyo
*.pyd

# OS files
.DS_Store
Thumbs.db
Desktop.ini
